# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://skill-up.ir"

# Production admin password for the Skill Up admin panel.
# Change this before running Docker on the server.
SKILLUP_ADMIN_USERNAME="admin"
SKILLUP_ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Random secret of at least 32 characters used to sign login sessions.
SKILLUP_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Public origin used in certificate QR links.
PUBLIC_BASE_URL="https://skill-up.ir"
