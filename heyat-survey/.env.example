# Created by: npm run setup
# The administrator password itself is never stored in this file.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Standalone Node.js settings
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data

# Docker: the host port is independent of Skill Up's existing port 4050.
BIND_ADDRESS=127.0.0.1
SURVEY_PORT=4175

# Optional prefix, e.g. /heyat when sharing the existing domain.
BASE_PATH=
# Origin only, e.g. https://skill-up.ir (no path or trailing subdirectory).
PUBLIC_BASE_URL=
COOKIE_SECURE=false
# Enable only behind a reverse proxy that overwrites forwarding headers.
TRUST_PROXY=false
