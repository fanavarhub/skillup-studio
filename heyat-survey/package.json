{
  "name": "heyat-shohada-survey-ui",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Persian event survey with Node.js, SQLite, private reporting and Excel export.",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "setup": "node tools/setup.mjs",
    "backup": "node --env-file-if-exists=.env tools/backup.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node tools/check.mjs",
    "package": "node tools/package-release.mjs"
  }
}
